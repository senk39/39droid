<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 17 (targetSdk 37): połączenia z urządzeniami w sieci lokalnej (NAS) wymagają tego uprawnienia
         (grupa „Urządzenia w pobliżu”); bez niego połączenia TCP z adresami LAN kończą się przekroczeniem czasu -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- odczyt istniejącej kopii biblioteki na karcie SD (MediaStore) -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- przejęty folder muzyki na karcie (np. /storage/XXXX-XXXX/Music): zapis pobranych, usuwanie po potwierdzeniu -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Simple Scrobbler (Simple Last.fm Scrobbler): sprawdzenie, czy jest zainstalowany, i broadcast SLS API -->
    <queries>
        <package android:name="com.adam.aslfms" />
    </queries>

    <application
        android:name=".App"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Droid39">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_MUSIC" />
            </intent-filter>
            <!-- „Odtwórz … w 39droid” (Asystent, Android Auto) -->
            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".media.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- widżety odtwarzacza (przyciski działają przez MediaButtonReceiver – także gdy aplikacja nie działa) -->
        <receiver android:name=".widget.PlayerWidget" android:exported="true" android:label="@string/widget_player">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_player_info" />
        </receiver>
        <receiver android:name=".widget.PlayerWidgetCover" android:exported="true" android:label="@string/widget_cover">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_cover_info" />
        </receiver>
        <receiver android:name=".widget.PlayerWidgetBar" android:exported="true" android:label="@string/widget_bar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_bar_info" />
        </receiver>
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true"
            android:label="Wygląd widżetu"
            android:theme="@style/Theme.Droid39"
            android:excludeFromRecents="true"
            android:taskAffinity="io.github.senk39.droid39.widget">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- wznowienie odtwarzania przyciskiem słuchawek / Bluetooth, gdy aplikacja nie działa -->
        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- pobieranie offline (WorkManager) jako usługa pierwszoplanowa typu dataSync -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
    </application>
</manifest>
